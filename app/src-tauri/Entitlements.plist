<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The daemon sidecar is a one-file PyInstaller binary: at launch it unpacks
	     libpython and its extension modules into a temp dir and loads them. Those
	     carry PyInstaller's ad-hoc signatures, which the hardened runtime's library
	     validation rejects ("different Team IDs") unless this is set. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
